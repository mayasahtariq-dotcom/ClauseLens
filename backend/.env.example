# ---- ClauseLens backend configuration (copy to .env; never commit real keys) ----
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173 # comma-separated; explicit origins only in production

# Persistence
PERSISTENCE_PROVIDER=sqlalchemy
DATABASE_URL=postgresql+psycopg://clauselens:clauselens@localhost:5432/clauselens

# Web research (tinyfish | fixture[demo, not allowed in production])
WEB_RESEARCH_PROVIDER=tinyfish
TINYFISH_API_KEY=
RESEARCH_MAX_PAGES_PER_VENDOR=6

# LLM (openai_compatible | openrouter | ollama | fixture[demo])
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4
LLM_OUTPUT_MODE=prompt              # prompt | json | schema
LLM_THINK=low

# Background jobs (celery | inline[dev only] | sync[tests])
JOB_QUEUE_PROVIDER=celery
REDIS_URL=redis://localhost:6379/0

# Optional raw-payload storage (none | local)
STORAGE_PROVIDER=none
